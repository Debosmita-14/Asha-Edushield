{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/gemini",  "destination": "/api/gemini" },
    { "source": "/api/eleven",  "destination": "/api/eleven" },
    { "source": "/api/alert",   "destination": "/api/alert"  }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
