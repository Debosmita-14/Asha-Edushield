# ASHA EduShield 2.0 — environment template
# Copy this file to `.env` and fill in your own keys. NEVER commit the real `.env`.

# Google Gemini (Vision + text) — https://aistudio.google.com/apikey
GEMINI_KEY=your-gemini-api-key

# ElevenLabs (voice agent) — https://elevenlabs.io
ELEVEN_KEY=your-elevenlabs-api-key
ELEVEN_VOICE=EXAVITQu4vr4xnSDxMaL

# Emergency alert channels (all optional — client simulates when absent)
# Resend (email) — https://resend.com
RESEND_KEY=
ALERT_FROM=ASHA Alerts <onboarding@resend.dev>

# Twilio (SMS / WhatsApp) — https://twilio.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
